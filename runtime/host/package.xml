<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_exchange_host</name>
  <version>0.1.0</version>
  <description>Host-side ROS2 nodes for arm exchange perception, planning, and task control.</description>
  <maintainer email="enterprize@ust.hk">HKUST ENTERPRIZE</maintainer>
  <license>Apache-2.0</license>

  <depend>arm_exchange_interfaces</depend>
  <depend>arm_exchange_core</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
