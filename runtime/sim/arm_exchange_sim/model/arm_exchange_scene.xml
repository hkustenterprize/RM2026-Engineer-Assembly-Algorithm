<mujoco model="arm_exchange_scene">
  <include file="model/arm/RM2026Arm.xml"/>
  <include file="model/exchange_station/exchange_station.xml"/>

  <statistic center="0 0 0.5" extent="1.5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
    <scale framelength="2.0" framewidth="0.1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Official exchange field platform: height 15cm, outer x edge at O-frame origin.
         The exchange E frame is constrained 0.0-0.1m behind this edge along x. -->
    <geom name="exchange_origin_platform"
          type="box"
          size="0.75 0.75 0.075"
          pos="-0.75 0 0.075"
          rgba="0.35 0.35 0.35 1"
          contype="1"
          conaffinity="1"
          friction="1 0.005 0.0001"/>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <camera name="fixed_view" pos="0.2 -1 0.5" quat="0.7071 0.7071 0 0" fovy="80"/>
  </worldbody>
</mujoco>
