<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_exchange_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo ROS2 simulation environment for the arm exchange task.</description>
  <maintainer email="zguobd@connect.ust.hk">HKUST ENTERPRIZE</maintainer>
  <license>MIT</license>

  <depend>arm_exchange_core</depend>
  <depend>arm_exchange_interfaces</depend>
  <depend>mujoco_engine</depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
